# URL pública del sitio (usada en metadata SEO, Open Graph, sitemap.xml y robots.txt).
# Ninguna de estas variables es obligatoria para desplegar: si no defines nada,
# el sitio usa los valores placeholder de abajo y el build en Vercel NO fallará.
NEXT_PUBLIC_SITE_URL=https://altfreestack.com

# Enlaces de afiliado para el widget de hosting (se muestran en cada ficha de
# herramienta y en /hosting-deals). Los tres ya tienen un valor real
# hardcodeado como fallback en src/lib/site-config.ts; defínelos aquí solo si
# quieres sobreescribir alguno sin tocar código.
NEXT_PUBLIC_AFFILIATE_DIGITALOCEAN=
NEXT_PUBLIC_AFFILIATE_VULTR=
NEXT_PUBLIC_AFFILIATE_RAILWAY=

# Token de GitHub (fine-grained, sin permisos especiales, solo lectura pública)
# usado para consultar estrellas/forks/issues en vivo en las fichas de cada
# herramienta. Sin él, el límite es de 60 peticiones/hora por IP (insuficiente
# para 121+ repos); con él sube a 5000/hora. Genera uno en
# https://github.com/settings/tokens?type=beta — opcional, sin él el sitio cae
# a las estrellas estimadas guardadas en el catálogo.
GITHUB_TOKEN=

# Envío de email para el formulario de /promote (solicitudes de patrocinio).
# Sin RESEND_API_KEY, el formulario sigue funcionando pero cada solicitud
# solo queda en los logs de la función (Vercel → Logs) — no llega ningún
# correo. Crea una cuenta gratuita en https://resend.com, genera una API
# key y pégala aquí para recibir las solicitudes por email de verdad.
RESEND_API_KEY=
# A qué dirección llegan las solicitudes. Si no se define, cae a
# lecastvarg@gmail.com (hardcodeado como fallback en la ruta de la API).
PROMOTE_NOTIFY_EMAIL=
# Remitente del email. Sin dominio propio verificado en Resend, usa el
# remitente de pruebas de Resend (onboarding@resend.dev) como fallback;
# verifica tu dominio en Resend y pon algo como "AltFreeStack <hola@altfreestack.com>"
# aquí cuando lo tengas.
RESEND_FROM_EMAIL=
