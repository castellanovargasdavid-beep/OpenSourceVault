# URL pública del sitio (usada en metadata SEO, Open Graph, sitemap.xml y robots.txt).
# Ninguna de estas variables es obligatoria para desplegar: si no defines nada,
# el sitio usa los valores placeholder de abajo y el build en Vercel NO fallará.
NEXT_PUBLIC_SITE_URL=https://altfreestack.com

# Enlaces de afiliado para el widget de hosting (se muestran en cada ficha de
# herramienta y en /hosting-deals). Reemplázalos por tus enlaces reales cuando
# los tengas; hasta entonces se usa un placeholder "#".
NEXT_PUBLIC_AFFILIATE_DIGITALOCEAN=
NEXT_PUBLIC_AFFILIATE_HETZNER=
NEXT_PUBLIC_AFFILIATE_RAILWAY=
